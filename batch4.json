  {"id":"NAFES-9-146","track":"nafes","level":"Grade 9","topic":"Quadratic Equations","type":"MCQ","difficulty":"hard","content":{"en":{"question":"Find the sum of roots of \\( 3x^2 - 7x + 2 = 0 \\).","options":["\\( \\dfrac{7}{3} \\)","\\( -\\dfrac{7}{3} \\)","\\( \\dfrac{2}{3} \\)","\\( 7 \\)"],"hint":"Sum of roots \\( = -\\dfrac{b}{a} \\).","explanation":"Sum \\( = -\\dfrac{-7}{3} = \\dfrac{7}{3} \\)."},"ar":{"question":"أوجد مجموع جذور \\( 3x^2 - 7x + 2 = 0 \\).","options":["\\( \\dfrac{7}{3} \\)","\\( -\\dfrac{7}{3} \\)","\\( \\dfrac{2}{3} \\)","\\( 7 \\)"],"hint":"مجموع الجذور \\( = -\\dfrac{b}{a} \\).","explanation":"\\( -\\dfrac{-7}{3} = \\dfrac{7}{3} \\)."}},"correct_index":"0"},
